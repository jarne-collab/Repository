---
import Icon from './Icon.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import EuropeMap from './EuropeMap.astro';
import { content, paths, WHATSAPP, type Lang } from '../i18n/content';
import { story } from '../i18n/story';
const { lang } = Astro.props as { lang: Lang };
const c = content[lang];
const stepIcons = ['goal', 'hello', 'plan', 'eye', 'climb'];
const bookIcons = ['climb', 'bed', 'plus', 'coin'];
const metaIcons = ['pin', 'cal', 'group', 'star'];
---
<Header lang={lang} page="home" />

<div id="intro-wrap">
<section id="intro" class="dark" aria-label="Grounded Climbing">
  <div class="panel left"><div class="photo" data-intro-a><img src="/img/intro-canyon.jpg" alt="Canyoning in een smalle, bemoste kloof met waterval" width="1400" height="1867" fetchpriority="high" /></div></div>
  <div class="panel right"><div class="photo warm" data-intro-b><img src="/img/intro-climb.jpg" alt="Klimmer in een overhangende rotswand tegen een dramatische lucht" width="1400" height="1867" fetchpriority="high" /></div></div>
  <div class="intro-shade"></div>
  <div class="intro-title"><span>Grounded</span><span>Climbing</span></div>
  <a class="scroll-cue" href="#hero" aria-label="Scroll"><span></span></a>
</section>
</div>

<main>
  <section id="hero" class="dark">
    <div class="photo hero-photo"><div class="inner" data-parallax><img src="/img/hero.jpg" alt="Zon boven een besneeuwd landschap met sparren en lange schaduwen" width="2000" height="1500" fetchpriority="high" /></div></div>
    <div class="content wrap">
      <h1>{c.hero.word}</h1>
      <p>{c.hero.line}</p>
      <a class="btn" href="#retreats">{c.hero.cta}</a>
    </div>
  </section>

  <section id="values" class="light">
    <div class="wrap">
      <div class="label"><Icon name="star" />{c.values.label}</div>
      <div class="circle" data-circle>
        <svg class="ring" viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="50" r="46"/><circle class="dot" cx="50" cy="4" r="1.4" data-orbit/></svg>
        {c.values.items.map((v, i) => <button class="word" aria-pressed={i === 0 ? 'true' : 'false'} data-i={i}>{v.word}</button>)}
        <div class="detail" aria-live="polite">
          {c.values.items.map((v, i) => <div hidden={i !== 0} data-detail={i}><small>{v.n} — {v.sub}</small>{v.text}</div>)}
        </div>
      </div>
    </div>
  </section>

  <section id="retreats" class="dark">
    <div class="wrap">
      <div class="label"><Icon name="star" />{c.retreats.label}</div>
      <div class="head reveal"><h2>{c.retreats.title}</h2><p>{c.retreats.intro}</p></div>
      <div class="cols3">
        {c.retreats.items.map((r) => (
          <article class="col reveal">
            <div class="photo" data-label={r.photo}>{r.image && <img src={r.image} alt={r.alt} width="900" height="1200" loading="lazy" />}</div>
            <div class="meta"><span>{r.date}</span><span class="price">{r.price}</span></div>
            <h3>{r.title}</h3><small>{r.place}</small>
            {r.note && <p style="margin:.8rem 0 0;font-size:.92rem;opacity:.85">{r.note}</p>}
            {r.bookUrl && <p style="margin:1.2rem 0 0"><a class="btn" href={r.bookUrl} rel="noopener" target="_blank">{c.retreats.book}</a></p>}
            {r.partner && <p style="margin:.4rem 0 0;font-size:.8rem;opacity:.7"><a href={r.partnerUrl} rel="noopener">{r.partner}</a></p>}
          </article>
        ))}
      </div>
      <ul class="includes">{c.retreats.includes.map((i) => <li class="reveal">{i}</li>)}</ul>
      <a class="btn" href="#contact">{c.retreats.more}</a>
    </div>
  </section>

  <section id="about" class="light about">
    <div class="wrap split">
      <div class="photo warm" data-label={c.about.photo}><img src={c.about.image} alt={c.about.alt} width="940" height="1175" loading="lazy" /></div>
      <div class="reveal">
        <div class="label"><Icon name="star" />{c.about.label}</div>
        <h2 style="font-size:clamp(1.6rem,2.6vw,2.35rem);line-height:1.1">{c.about.title}</h2>
        <p class="lead" style="margin-top:2rem">{c.about.text}</p>
        <div class="stats">{c.about.stats.map((s) => <div><b>{s.v}</b><span>{s.l}</span></div>)}</div>
      </div>
    </div>
  </section>

  <section id="offer" class="dark">
    <div class="wrap">
      <div class="label"><Icon name="star" />{c.offer.label}</div>
      <h2 class="reveal" style="margin-bottom:3rem">{c.offer.title}</h2>
      <div class="cards">
        {c.offer.cards.map((k) => (
          <button class="card reveal" aria-expanded="false">
            <div class="photo warm" data-label={k.photo}></div>
            <div><span class="num">{k.n}</span><h3 style="margin-top:.6rem">{k.title}</h3><p class="price" style="margin-top:.6rem">{k.price}</p></div>
            <div>
              <ul>{k.meta.map((m, i) => <li><Icon name={metaIcons[i]} />{m}</li>)}</ul>
              <span class="tap">{c.offer.tap}</span>
            </div>
          </button>
        ))}
      </div>
    </div>
  </section>

  <section id="training" class="light">
    <div class="wrap">
      <div class="label"><Icon name="star" />{c.training.label}</div>
      <h2 class="reveal">{c.training.title}</h2>
      <ol class="steps">{c.training.steps.map((s, i) => <li class="reveal"><Icon name={stepIcons[i]} /><h3>{s.t}</h3><p>{s.d}</p></li>)}</ol>
    </div>
  </section>

  <section id="booking" class="dark">
    <div class="wrap">
      <div class="label"><Icon name="star" />{c.booking.label}</div>
      <h2 class="reveal">{c.booking.title}</h2>
      <ol class="steps">{c.booking.steps.map((s, i) => <li class="reveal"><Icon name={bookIcons[i]} /><h3>{s.t}</h3><p>{s.d}</p></li>)}</ol>
      <p style="margin-top:3rem"><a class="btn" href={WHATSAPP} rel="noopener">{c.booking.cta}</a></p>
    </div>
  </section>

  <section id="story" class="light">
    <div class="wrap split">
      <div class="photo warm" data-label={story[lang].chapters[2].photo.label}><img src={story[lang].chapters[2].photo.src} alt={story[lang].teaser.alt} width="1800" height="1350" loading="lazy" /></div>
      <div class="reveal">
        <div class="label"><Icon name="star" />{c.story.label}</div>
        <h2 style="font-size:clamp(2rem,4.5vw,3.6rem);margin-bottom:1.6rem">{c.story.title}</h2>
        <p class="lead">{story[lang].teaser.text}</p>
        <p style="margin-top:2rem"><a class="btn" href={paths.story[lang]}>{story[lang].teaser.button}</a></p>
      </div>
    </div>
  </section>

  <section id="people" class="dark">
    <div class="wrap">
      <div class="label"><Icon name="star" />{c.people.label}</div>
      <h2 class="reveal" style="margin-bottom:3rem">{c.people.title}</h2>
      <div class="people">
        {c.people.items.map((p) => (
          <button class="person reveal" aria-expanded="false">
            <div class="photo" data-label={`Portret ${p.name}`}></div>
            <div class="bio">{p.bio}<br/><small>{c.people.hint}</small></div>
            <h3>{p.name}</h3><small>{p.role}</small>
          </button>
        ))}
      </div>
      <p style="margin-top:3rem"><a class="btn" href={paths.team[lang]}>{c.people.all}</a></p>
    </div>
  </section>

  <section id="map" class="dark map" style="padding-top:0">
    <div class="wrap">
      <div class="label"><Icon name="star" />{c.map.label}</div>
      <h2 class="reveal" style="margin-bottom:2rem">{c.map.title}</h2>
      <EuropeMap lang={lang} label={c.map.title} home={c.map.home} retreat={c.map.retreat} />
      <ul class="map-list reveal">
        <li><span class="dot"></span><div><b>{c.retreats.items[0].title} · {c.retreats.items[0].place}</b><span>{c.retreats.items[0].date}</span></div><a class="btn" href="#retreats">{c.map.cta}</a></li>
      </ul>
    </div>
  </section>

  <section id="gift" class="sand gift">
    <div class="wrap split">
      <div class="reveal"><div class="label"><Icon name="star" />{c.gift.label}</div><h2>{c.gift.title}</h2></div>
      <div class="reveal"><p>{c.gift.text}</p><a class="btn" href="#contact">{c.gift.cta}</a></div>
    </div>
  </section>

  <section id="contact" class="light">
    <div class="wrap split">
      <div class="photo" data-label="Contact — foto"></div>
      <div>
        <div class="label"><Icon name="star" />{c.contact.label}</div>
        <h2 style="margin-bottom:2rem">{c.contact.title}</h2>
        <!-- TODO: koppel aan een formulierdienst (bv. Formspree / Netlify Forms) -->
        <form data-form action="#" method="post">
          <label>{c.contact.form.name}<input name="name" required autocomplete="name" /></label>
          <label>{c.contact.form.email}<input name="email" type="email" required autocomplete="email" /></label>
          <label>{c.contact.form.topic}<select name="topic">{c.contact.form.topics.map((t) => <option>{t}</option>)}</select></label>
          <label>{c.contact.form.message}<textarea name="message" required></textarea></label>
          <div><button class="btn" type="submit">{c.contact.form.send}</button> <a href={WHATSAPP} style="margin-left:1rem">{c.contact.or}</a></div>
          <p data-sent hidden>{c.contact.form.sent}</p>
        </form>
      </div>
    </div>
  </section>
</main>

<Footer lang={lang} />
